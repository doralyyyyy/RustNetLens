{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop permissions for RustNetLens",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "allow-proxy-status",
    "allow-start-proxy",
    "allow-stop-proxy",
    "allow-https-mitm-status",
    "allow-generate-root-ca",
    "allow-set-https-mitm-enabled",
    "allow-list-sessions",
    "allow-traffic-overview",
    "allow-get-session-detail",
    "allow-clear-sessions",
    "allow-list-rules",
    "allow-save-rule",
    "allow-delete-rule",
    "allow-replay-session",
    "allow-export-sessions",
    "allow-list-collections",
    "allow-save-collection",
    "allow-delete-collection",
    "allow-add-session-to-collection"
  ]
}
